@{
    ViewData["Title"] = "Results";
    var results = ViewBag.Results as List<Osint_Eye_Web.Models.AccountResult>;
}

<div class="container mt-5">
    <h2 class="text-center">Search Results</h2>

    @if (results != null && results.Any())
    {
        <div class="table-responsive mt-4">
            <table class="table table-striped border-secondary">
                <thead>
                    <tr>
                        <th scope="col">Profile URL</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var result in results)
                    {
                        <tr>
                            <td>
                                <a href="@result.ProfileUrl" target="_blank" class="text-decoration-none text-light">@result.ProfileUrl</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-warning text-center mt-4" role="alert">
            No results found. Please try a different username.
        </div>
    }
</div>
